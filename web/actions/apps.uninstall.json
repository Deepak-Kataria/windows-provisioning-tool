{
  "id": "apps.uninstall",
  "title": "Uninstall apps",
  "description": "Uninstalls catalog apps with winget.",
  "min_role": "technician",
  "timeout_seconds": 3600,
  "params": {
    "required": ["ids"],
    "properties": {
      "ids": {
        "type": "array",
        "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,99}$"},
        "minItems": 1,
        "maxItems": 50,
        "uniqueItems": true
      }
    }
  },
  "agent": {"type": "builtin", "name": "winget", "mode": "uninstall"}
}
