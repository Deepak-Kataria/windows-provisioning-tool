{
  "id": "tweaks.apply",
  "title": "Tweaks: apply / undo",
  "description": "Applies or undoes tweaks. Per-user tweaks go to every signed-in user.",
  "min_role": "technician",
  "timeout_seconds": 1800,
  "params": {
    "properties": {
      "ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,40}$"
        },
        "minItems": 1,
        "maxItems": 100,
        "uniqueItems": true
      },
      "mode": {
        "enum": [
          "apply",
          "undo"
        ]
      }
    },
    "required": [
      "ids"
    ]
  },
  "agent": {
    "type": "builtin",
    "name": "tweaks_apply"
  }
}
